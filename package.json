{
  "name": "@angelitosystems/nestjs-pdf",
  "version": "0.1.2",
  "description": "Modern, robust and enterprise-grade PDF generation module for NestJS powered by Playwright and Handlebars",
  "author": "Angelito Systems <contact@angelitosystems.com>",
  "homepage": "https://angelitosystems.github.io/nestjs-pdf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelitosystems/nestjs-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/angelitosystems/nestjs-pdf/issues"
  },
  "license": "MIT",
  "keywords": [
    "nestjs",
    "pdf",
    "playwright",
    "handlebars",
    "html-to-pdf",
    "pdf-generation",
    "typescript",
    "browser-pool",
    "concurrency",
    "angelito-systems"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "angelito-pdf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "doctor": "node ./dist/cli.js doctor",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,tests,examples}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,tests,examples}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,tests,examples}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,examples}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "deploy:npm": "node scripts/deploy.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "mime-types": "^2.1.35",
    "playwright-core": "^1.49.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.10.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "file-type": "^22.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}